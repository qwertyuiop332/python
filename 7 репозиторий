# 1. Создаем матрицу 3x3
matrix = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]

# 2. Определяем размер матрицы (для универсальности)
n = len(matrix) # В данном случае n = 3

# 3. Инициализируем сумму
diagonal_sum = 0

# 4. Проходим по матрице для суммирования чисел по диагонали (справа налево)
# Индексы для диагонали: (0, 2), (1, 1), (2, 0)
for i in range(n):
    # Индекс строки: i
    # Индекс столбца: n - 1 - i
    diagonal_sum += matrix[i][n - 1 - i]

# 5. Выводим результат
print(f"Матрица:\n{matrix[0]}\n{matrix[1]}\n{matrix[2]}")
print(f"\nСумма чисел по диагонали (справа налево): {diagonal_sum}")

